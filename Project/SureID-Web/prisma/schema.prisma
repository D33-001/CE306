datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. IDENTITY & RBAC
// ==========================================

model User {
  user_id               String   @id @default(uuid())
  email                 String   @unique
  password_hash         String?
  display_name          String
  oauth_provider        String   @default("email")
  role                  String   @default("user") // user, inspector, admin, owner
  wallet_balance        Decimal  @default(0.00) @db.Decimal(12, 2)
  escrow_locked_balance Decimal  @default(0.00) @db.Decimal(12, 2)
  trust_score           Int      @default(85)
  is_verified           Boolean  @default(false)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  listings              Listing[]
  buyer_escrows         EscrowContract[]   @relation("BuyerEscrows")
  seller_escrows        EscrowContract[]  @relation("SellerEscrows")
  inspector_escrows     EscrowContract[]  @relation("InspectorEscrows")
  ledgers               DoubleEntryLedger[]
  bank_accounts         BankAccount[]
  withdrawals           WithdrawalRequest[]
  kyc                   KycRecord?
  buyer_chats           ItemChatThread[]  @relation("BuyerChats")
  seller_chats          ItemChatThread[] @relation("SellerChats")
  buyer_offers          ItemOffer[]       @relation("BuyerOffers")
  seller_offers         ItemOffer[]      @relation("SellerOffers")
  notifications         Notification[]
  webhook_subscriptions WebhookSubscription[]

  @@map("users")
}

// ==========================================
// 2. MARKETPLACE LISTINGS & DYNAMIC SPECS
// ==========================================

model Listing {
  listing_id         String   @id @default(uuid())
  seller_id          String
  category_type      String   // individual_game, game_library, ingame_item
  platform_id        String   // rov, roblox, valorant, cs2_item, steam_library, etc.
  game_type          String   // ROV, ROBLOX, VALORANT, etc.
  title              String
  description        String   @db.Text
  asking_price       Decimal  @db.Decimal(12, 2)
  negotiable         Boolean  @default(true)
  warranty_days      Int      @default(14)
  escrow_fee_percent Decimal  @default(7.50) @db.Decimal(5, 2)
  is_featured_boost  Boolean  @default(false)
  verification_tier  String   @default("standard") // standard, guaranteed, admin_verified
  status             String   @default("available") // available, in_escrow, sold, cancelled
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  seller             User     @relation(fields: [seller_id], references: [user_id])
  spec               InventorySpec?
  escrow             EscrowContract?
  chat_threads       ItemChatThread[]

  @@map("listings")
}

model InventorySpec {
  spec_id                String   @id @default(uuid())
  listing_id             String   @unique
  category_type          String
  platform_id            String
  specs_data             Json     // JSONB Dynamic Game Attributes
  estimated_market_value Decimal  @db.Decimal(12, 2)
  created_at             DateTime @default(now())

  listing                Listing  @relation(fields: [listing_id], references: [listing_id], onDelete: Cascade)

  @@map("inventory_specs")
}

// ==========================================
// 3. 5-STEP ESCROW CONTRACT & LEDGER
// ==========================================

model EscrowContract {
  escrow_id             String    @id @default(uuid())
  listing_id            String    @unique
  listing_title         String
  category_type         String    @default("individual_game")
  platform_id           String
  game_type             String
  is_item_trade         Boolean   @default(false)
  buyer_id              String
  seller_id             String
  inspector_id          String?
  total_amount          Decimal   @db.Decimal(12, 2)
  commission_fee        Decimal   @db.Decimal(12, 2)
  seller_net_income     Decimal   @db.Decimal(12, 2)
  current_step          Int       @default(1) // 1 to 5
  step_status           String    @default("funds_locked")
  encrypted_credentials Json?     // AES-256-GCM encrypted payload, iv, authTag
  delivery_proof        Json?     // In-game trade screenshot, IGN, trade method
  is_disputed           Boolean   @default(false)
  created_at            DateTime  @default(now())
  completed_at          DateTime?

  listing               Listing   @relation(fields: [listing_id], references: [listing_id])
  buyer                 User      @relation("BuyerEscrows", fields: [buyer_id], references: [user_id])
  seller                User      @relation("SellerEscrows", fields: [seller_id], references: [user_id])
  inspector             User?     @relation("InspectorEscrows", fields: [inspector_id], references: [user_id])
  logs                  EscrowLog[]
  messages              EscrowMessage[]
  disputes              DisputeRecord[]

  @@map("escrows")
}

model EscrowLog {
  log_id     String   @id @default(uuid())
  escrow_id  String
  step       Int
  action     String
  message    String
  created_at DateTime @default(now())

  escrow     EscrowContract @relation(fields: [escrow_id], references: [escrow_id], onDelete: Cascade)

  @@map("escrow_logs")
}

model EscrowMessage {
  message_id  String   @id @default(uuid())
  escrow_id   String
  sender_id   String
  sender_name String
  role        String
  text        String   @db.Text
  created_at  DateTime @default(now())

  escrow      EscrowContract @relation(fields: [escrow_id], references: [escrow_id], onDelete: Cascade)

  @@map("escrow_messages")
}

model DoubleEntryLedger {
  ledger_id      String   @id @default(uuid())
  user_id        String
  escrow_id      String?
  entry_type     String   // topup, escrow_lock, escrow_release, commission_revenue, withdrawal_request
  amount         Decimal  @db.Decimal(12, 2)
  balance_before Decimal  @db.Decimal(12, 2)
  balance_after  Decimal  @db.Decimal(12, 2)
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [user_id])

  @@map("ledgers")
}

// ==========================================
// 4. KYC & BANKING PAYOUTS
// ==========================================

model KycRecord {
  kyc_id            String    @id @default(uuid())
  user_id           String    @unique
  full_name_th      String
  id_card_number    String
  id_card_image_url String
  selfie_image_url  String
  status            String    @default("pending") // pending, approved, rejected
  rejection_reason  String?
  reviewed_by       String?
  submitted_at      DateTime  @default(now())
  reviewed_at       DateTime?

  user              User      @relation(fields: [user_id], references: [user_id])

  @@map("kyc_records")
}

model BankAccount {
  account_id          String   @id @default(uuid())
  user_id             String
  bank_name           String
  account_number      String
  account_holder_name String
  is_primary          Boolean  @default(true)
  created_at          DateTime @default(now())

  user                User     @relation(fields: [user_id], references: [user_id])
  withdrawals         WithdrawalRequest[]

  @@map("bank_accounts")
}

model WithdrawalRequest {
  withdrawal_id       String    @id @default(uuid())
  user_id             String
  bank_account_id     String
  bank_name           String
  account_number      String
  account_holder_name String
  amount              Decimal   @db.Decimal(12, 2)
  fee                 Decimal   @default(15.00) @db.Decimal(6, 2)
  net_payout          Decimal   @db.Decimal(12, 2)
  status              String    @default("pending") // pending, approved_paid, rejected
  transfer_slip_url   String?
  processed_by        String?
  created_at          DateTime  @default(now())
  processed_at        DateTime?

  user                User        @relation(fields: [user_id], references: [user_id])
  bank_account        BankAccount @relation(fields: [bank_account_id], references: [account_id])

  @@map("withdrawals")
}

// ==========================================
// 5. DISPUTES & ARBITRATION
// ==========================================

model DisputeRecord {
  dispute_id        String    @id @default(uuid())
  escrow_id         String
  claimant_id       String
  respondent_id     String
  category          String
  title             String
  description       String    @db.Text
  evidence_urls     Json      // String array of URLs
  status            String    @default("under_arbitration") // under_arbitration, resolved_buyer_refund, resolved_seller_payout
  arbitration_notes String?   @db.Text
  arbitrated_by     String?
  created_at        DateTime  @default(now())
  resolved_at       DateTime?

  escrow            EscrowContract @relation(fields: [escrow_id], references: [escrow_id])

  @@map("disputes")
}

// ==========================================
// 6. ITEM-BOUND CHAT & OFFERS
// ==========================================

model ItemChatThread {
  thread_id       String   @id @default(uuid())
  listing_id      String
  listing_title   String
  buyer_id        String
  seller_id       String
  active_offer_id String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  listing         Listing  @relation(fields: [listing_id], references: [listing_id])
  buyer           User     @relation("BuyerChats", fields: [buyer_id], references: [user_id])
  seller          User     @relation("SellerChats", fields: [seller_id], references: [user_id])
  messages        ItemChatMessage[]
  offers          ItemOffer[]

  @@map("item_chat_threads")
}

model ItemChatMessage {
  message_id  String   @id @default(uuid())
  thread_id   String
  sender_id   String
  sender_name String
  role        String
  text        String   @db.Text
  offer_id    String?
  created_at  DateTime @default(now())

  thread      ItemChatThread @relation(fields: [thread_id], references: [thread_id], onDelete: Cascade)

  @@map("item_chat_messages")
}

model ItemOffer {
  offer_id         String    @id @default(uuid())
  thread_id        String
  listing_id       String
  buyer_id         String
  seller_id        String
  offered_price    Decimal   @db.Decimal(12, 2)
  original_price   Decimal   @db.Decimal(12, 2)
  discount_amount  Decimal   @db.Decimal(12, 2)
  discount_percent Decimal   @db.Decimal(5, 2)
  status           String    @default("pending") // pending, accepted, declined, countered, escrowed
  escrow_id        String?
  message          String    @db.Text
  created_at       DateTime  @default(now())
  resolved_at      DateTime?

  thread           ItemChatThread @relation(fields: [thread_id], references: [thread_id], onDelete: Cascade)
  buyer            User           @relation("BuyerOffers", fields: [buyer_id], references: [user_id])
  seller           User           @relation("SellerOffers", fields: [seller_id], references: [user_id])

  @@map("item_offers")
}

// ==========================================
// 7. BLACKLIST FRAUD SHIELD
// ==========================================

model Blacklist {
  blacklist_id        String   @id @default(uuid())
  scammer_name        String
  bank_account_number String
  bank_name           String
  game_uid            String
  scam_method         String   @db.Text
  reported_at         DateTime @default(now())

  @@map("blacklist")
}

// ==========================================
// 8. OMNICHANNEL NOTIFICATIONS & WEBHOOKS
// ==========================================

model Notification {
  notification_id String   @id @default(uuid())
  user_id         String
  channel         String   // in_app, line, email, webhook
  event_type      String   // escrow.funds_locked, offer.received, wallet.deposited, etc.
  title           String
  message         String   @db.Text
  metadata        Json?
  is_read         Boolean  @default(false)
  sent_status     String   @default("delivered") // queued, delivered, failed
  created_at      DateTime @default(now())

  user            User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("notifications")
}

model WebhookSubscription {
  subscription_id String   @id @default(uuid())
  user_id         String
  target_url      String
  secret_key      String
  events          String[] // ["offer.*", "escrow.*", "wallet.*"]
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user            User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("webhook_subscriptions")
}
