PORT=4000
NODE_ENV=development

# PostgreSQL Connection String (Docker / Local / Cloud)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/escrow_vault_db?schema=public"

# Redis Connection String
REDIS_URL="redis://localhost:6379"

# Enterprise Secret Key for AES-256-GCM Vault Encryption (Must be 32 bytes)
VAULT_ENCRYPTION_KEY="escrow_vault_enterprise_secure_key_2026_32bytes!!"

# Google OAuth 2.0 Web Client ID (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
